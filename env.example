# Cogents TV broadcaster settings  (lives at /opt/cogents-broadcast/.env)

# Twitch → Creator Dashboard → Settings → Stream → Primary Stream key. KEEP SECRET.
TWITCH_STREAM_KEY=

# Your site's TV page. "sound" turns voices on, "quality" lowers 3D detail to save CPU.
TV_URL=https://YOUR-DOMAIN/?sound&quality=0.7#/tv

# Picture. 1280x720 at 30 fps is the sweet spot for a CPU-only server.
WIDTH=1280
HEIGHT=720
FPS=30
VIDEO_BITRATE=3000k

# Twitch ingest server. The default picks the nearest one automatically.
TWITCH_INGEST=rtmp://live.twitch.tv/app
