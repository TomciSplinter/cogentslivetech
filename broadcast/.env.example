# Cogents TV broadcaster settings  (lives at /opt/cogents-broadcast/.env)

# Twitch → Creator Dashboard → Settings → Stream → Primary Stream key. KEEP SECRET.
TWITCH_STREAM_KEY=

# Your site's TV page, in quotes. "sound" turns voices on, "quality" lowers 3D detail to save CPU.
TV_URL="https://YOUR-DOMAIN/?sound&quality=0.4&fps=20#/tv"

# Picture. 1280x720 at 30 fps is the sweet spot for a 4-core server.
# The server has no GPU, so the 3D minds are drawn in software: keep quality=0.4&fps=20 in TV_URL.
# On a 2-core server (CX23) also use FPS=24 and PRESET=ultrafast.
WIDTH=1280
HEIGHT=720
FPS=30
VIDEO_BITRATE=3000k
PRESET=veryfast

# Twitch ingest server. The default picks the nearest one automatically.
TWITCH_INGEST=rtmp://live.twitch.tv/app
